ASPNETCORE_ENVIRONMENT=Development
AWS_EMF_NAMESPACE=GmrProcessor
DataApi__BaseAddress=http://wiremock
GvmsApi__ClientId=${GVMS_API_CLIENT_ID}
GvmsApi__ClientSecret=${GVMS_API_CLIENT_SECRET}
Mongo__DatabaseUri=mongodb://mongodb:27017/?tls=false
PORT=8080
S3_ENDPOINT=http://floci:4566
SNS_ENDPOINT=http://floci:4566
SQS_ENDPOINT=http://floci:4566
TradeImportsServiceBus__Eta__ConnectionString=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true
TradeImportsServiceBus__ImportMatchResult__ConnectionString=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true
USE_LOCALSTACK=${USE_LOCALSTACK:-true}

# feature flags
ENABLE_DATA_EVENT_SQS_CONSUMER=true
ENABLE_MATCHED_GMR_SQS_CONSUMERS=true
ENABLE_TRADE_IMPORTS_MESSAGING=true
ENABLE_STORE_OUTBOUND_MESSAGES=true
ENABLE_GVMS_API_CLIENT_HOLD=true
ENABLE_GVMS_API_CLIENT_IGNORE_NOT_FOUND=true
ENABLE_DEV_ENDPOINTS=true
DEV_ENDPOINT_USERNAME=test
DEV_ENDPOINT_PASSWORD=test
